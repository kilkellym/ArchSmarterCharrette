<Window x:Class="ReRender.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReRender Settings"
        Width="520"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Window.Resources>

        <!-- Colors -->
        <SolidColorBrush x:Key="CardBg" Color="#2D2D2D" />
        <SolidColorBrush x:Key="CardBorder" Color="#3E3E3E" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E0E0E0" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A0A0" />
        <SolidColorBrush x:Key="HeadingColor" Color="#F5C842" />
        <SolidColorBrush x:Key="InputBg" Color="#383838" />
        <SolidColorBrush x:Key="InputBorder" Color="#505050" />
        <SolidColorBrush x:Key="BtnSecondaryBg" Color="#383838" />
        <SolidColorBrush x:Key="BtnSecondaryHover" Color="#454545" />

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource HeadingColor}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Field label -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- Text input -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox toggle button (the closed-state chrome) -->
        <ControlTemplate x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
            <Border x:Name="border"
                    Background="{StaticResource InputBg}"
                    BorderBrush="{StaticResource InputBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <!-- Arrow glyph -->
                    <Path Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{StaticResource TextSecondary}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
        </ControlTemplate>

        <!-- ComboBox -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggle}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,28,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource InputBg}"
                                            BorderBrush="{StaticResource InputBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,1,0,0" />
                                    <ScrollViewer Margin="2,3" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BtnSecondaryBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="20,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource BtnSecondaryHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card container -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Window title -->
        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{StaticResource HeadingColor}"
                   Margin="0,0,0,16" />

        <!-- Settings card -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- 0: API Key label -->
                    <RowDefinition Height="Auto" />  <!-- 1: API Key input -->
                    <RowDefinition Height="12" />    <!-- 2: spacer -->
                    <RowDefinition Height="Auto" />  <!-- 3: Model label -->
                    <RowDefinition Height="Auto" />  <!-- 4: Model combo -->
                    <RowDefinition Height="16" />    <!-- 5: spacer -->
                    <RowDefinition Height="Auto" />  <!-- 6: Save Location label -->
                    <RowDefinition Height="Auto" />  <!-- 7: Save Location input + Browse -->
                    <RowDefinition Height="16" />    <!-- 8: spacer -->
                    <RowDefinition Height="Auto" />  <!-- 9: Library Folder label -->
                    <RowDefinition Height="Auto" />  <!-- 10: Library Folder input -->
                    <RowDefinition Height="8" />     <!-- 11: spacer -->
                    <RowDefinition Height="Auto" />  <!-- 12: Library File label -->
                    <RowDefinition Height="Auto" />  <!-- 13: Library File combo + Edit -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Google API Key"
                           Style="{StaticResource LabelStyle}" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Masked view (default) -->
                    <PasswordBox x:Name="ApiKeyPasswordBox"
                                 Grid.Column="0"
                                 Height="30"
                                 Background="{StaticResource InputBg}"
                                 Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource InputBorder}"
                                 BorderThickness="1"
                                 FontSize="12"
                                 PasswordChanged="ApiKeyPasswordBox_PasswordChanged" />
                    <!-- Plain-text view (hidden by default) -->
                    <TextBox x:Name="ApiKeyTextBox"
                             Grid.Column="0"
                             Height="30"
                             Visibility="Collapsed"
                             Style="{StaticResource DarkTextBox}"
                             TextChanged="ApiKeyTextBox_TextChanged" />
                    <Button Grid.Column="2"
                            x:Name="BtnToggleApiKey"
                            Content="Show"
                            Width="75"
                            Height="32"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnToggleApiKey_Click" />
                </Grid>

                <TextBlock Grid.Row="3" Text="Model"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox Grid.Row="4"
                          Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModel}" />

                <!-- Output folder -->
                <TextBlock Grid.Row="6" Text="Image Save Location"
                           Style="{StaticResource LabelStyle}" />
                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Height="30"
                             Style="{StaticResource DarkTextBox}"
                             Text="{Binding OutputFolder, UpdateSourceTrigger=LostFocus}" />
                    <Button Grid.Column="2"
                            Content="Browse"
                            Width="85"
                            Height="32"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnBrowseOutputFolder_Click" />
                </Grid>

                <!-- Prompt Library section -->
                <TextBlock Grid.Row="9" Text="Prompt Library Folder"
                           Style="{StaticResource LabelStyle}" />
                <TextBox Grid.Row="10"
                         Height="30"
                         Style="{StaticResource DarkTextBox}"
                         Text="{Binding PromptLibraryFolder, UpdateSourceTrigger=LostFocus}" />

                <TextBlock Grid.Row="12" Text="Prompt Library File"
                           Style="{StaticResource LabelStyle}" />
                <Grid Grid.Row="13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding AvailableLibraryFiles}"
                              SelectedItem="{Binding SelectedLibraryFile}" />
                    <Button Grid.Column="2"
                            Content="Edit"
                            Width="75"
                            Height="32"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnEditPromptLibrary_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- Button row -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Close"
                    VerticalContentAlignment="Center"
                    Width="90"
                    Height="30"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnClose_Click" />
        </StackPanel>
    </Grid>

</Window>
