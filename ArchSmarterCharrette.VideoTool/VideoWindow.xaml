<Window x:Class="ArchSmarterCharrette.VideoTool.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:ArchSmarterCharrette.VideoTool.Data"
        Title="Charrette Video"
        Width="520"
        Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1E1E1E">

    <Window.Resources>

        <!-- Colors -->
        <SolidColorBrush x:Key="CardBg" Color="#2D2D2D" />
        <SolidColorBrush x:Key="CardBorder" Color="#3E3E3E" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E0E0E0" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A0A0" />
        <SolidColorBrush x:Key="TextMuted" Color="#707070" />
        <SolidColorBrush x:Key="HeadingColor" Color="#F5C842" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4E9FE5" />
        <SolidColorBrush x:Key="AccentHover" Color="#5DB0F0" />
        <SolidColorBrush x:Key="AccentPressed" Color="#3D8ED4" />
        <SolidColorBrush x:Key="InputBg" Color="#383838" />
        <SolidColorBrush x:Key="InputBorder" Color="#505050" />
        <SolidColorBrush x:Key="BtnSecondaryBg" Color="#383838" />
        <SolidColorBrush x:Key="BtnSecondaryHover" Color="#454545" />

        <!-- Field label -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- Text input -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- System color overrides for ComboBox dropdown -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#383838" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4E9FE5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E0E0E0" />

        <!-- ComboBox toggle button -->
        <ControlTemplate x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
            <Border x:Name="border"
                    Background="{StaticResource InputBg}"
                    BorderBrush="{StaticResource InputBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{StaticResource TextSecondary}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
        </ControlTemplate>

        <!-- ComboBox -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggle}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,28,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource InputBg}"
                                            BorderBrush="{StaticResource InputBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,1,0,0" />
                                    <ScrollViewer Margin="2,3" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="20,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BtnSecondaryBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource BtnSecondaryHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <data:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

    </Window.Resources>

    <!-- Outer two-column layout: main content + gallery panel -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Main content column -->
        <Grid Grid.Column="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- 0: Title -->
                <RowDefinition Height="Auto" />   <!-- 1: Model + settings + gallery toggle -->
                <RowDefinition Height="Auto" />   <!-- 2: Browse + source image -->
                <RowDefinition Height="Auto" />   <!-- 3: Image preview (spanned) -->
                <RowDefinition Height="Auto" />   <!-- 4: Controls -->
                <RowDefinition Height="*" />      <!-- 5: Status -->
                <RowDefinition Height="Auto" />   <!-- 6: Buttons -->
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="Charrette Video"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource HeadingColor}"
                       Margin="0,0,0,10" />

            <!-- Model dropdown + settings + gallery toggle -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding VideoModels}"
                          SelectedItem="{Binding SelectedVideoModel}" />

                <Button Grid.Column="1"
                        Width="40"
                        Height="24"
                        Padding="0,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="Settings"
                        Margin="8,0,6,0"
                        Click="BtnSettings_Click">
                    <Path Data="M 8 4.8 A 3.2 3.2 0 1 1 8 11.2 A 3.2 3.2 0 1 1 8 4.8 M 7.2 0 L 8.8 0 L 9.2 2.2 L 10.8 2.8 L 12.6 1.6 L 13.8 2.8 L 12.6 4.6 L 13.2 6.2 L 15.4 6.6 L 15.4 8.2 L 13.2 8.6 L 12.6 10.2 L 13.8 12 L 12.6 13.2 L 10.8 12 L 9.2 12.6 L 8.8 14.8 L 7.2 14.8 L 6.8 12.6 L 5.2 12 L 3.4 13.2 L 2.2 12 L 3.4 10.2 L 2.8 8.6 L 0.6 8.2 L 0.6 6.6 L 2.8 6.2 L 3.4 4.6 L 2.2 2.8 L 3.4 1.6 L 5.2 2.8 L 6.8 2.2 Z"
                          Fill="{StaticResource TextSecondary}"
                          Stretch="Uniform"
                          Width="14"
                          Height="14" />
                </Button>

                <Button Grid.Column="2"
                        Width="40"
                        Height="24"
                        Padding="0,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="Toggle video gallery"
                        Click="BtnToggleGallery_Click">
                    <Path x:Name="GalleryArrow"
                          Data="M 0 0 L 4 4 L 0 8 Z"
                          Fill="{StaticResource TextSecondary}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Source image card (browse + preview) -->
            <Border Grid.Row="2"
                    Grid.RowSpan="2"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Select an image to generate the video from."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,8" />

                    <Button Content="Browse..."
                            Width="90"
                            Height="30"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnBrowse_Click" />

                    <!-- Source label (shows filename after selection) -->
                    <TextBlock Text="{Binding SourceImageLabel}"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasSourceImage, Converter={StaticResource BoolToVis}}" />

                    <!-- Image preview -->
                    <Image Source="{Binding Thumbnail}"
                           MaxHeight="140"
                           Stretch="Uniform"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Visibility="{Binding HasSourceImage, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- Controls -->
            <StackPanel Grid.Row="4">
                <!-- Camera Motion -->
                <TextBlock Text="Camera Motion" Style="{StaticResource LabelStyle}" />
                <ComboBox Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding MotionPresets}"
                          SelectedItem="{Binding SelectedMotionPreset}"
                          DisplayMemberPath="DisplayName"
                          Margin="0,0,0,10" />

                <!-- Custom Instructions -->
                <TextBlock Text="Additional Instructions" Style="{StaticResource LabelStyle}" />
                <TextBox Style="{StaticResource DarkTextBox}"
                         Text="{Binding CustomMotionText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="44"
                         Margin="0,0,0,10" />

                <!-- Resolution + Duration -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Resolution" Style="{StaticResource LabelStyle}" />
                        <ComboBox Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding Resolutions}"
                                  SelectedItem="{Binding SelectedResolution}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Duration (sec)" Style="{StaticResource LabelStyle}" />
                        <ComboBox Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding Durations}"
                                  SelectedItem="{Binding SelectedDuration}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Status area -->
            <StackPanel Grid.Row="5" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,0,0,8"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource CardBg}"
                             BorderThickness="0"
                             Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           Foreground="{Binding StatusColor}"
                           FontSize="12"
                           Margin="4,0,0,0" />
            </StackPanel>

            <!-- Button row -->
            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button x:Name="BtnGenerate"
                        Content="Generate"
                        Width="110"
                        Height="32"
                        Margin="0,0,10,0"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding CanGenerate}"
                        Click="BtnGenerate_Click" />
                <Button x:Name="BtnCancel"
                        Content="Cancel"
                        Width="90"
                        Height="30"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButton}"
                        Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"
                        Click="BtnCancel_Click" />
                <Button Content="Close"
                        Width="90"
                        Height="30"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnClose_Click" />
            </StackPanel>
        </Grid>

        <!-- Video gallery side panel -->
        <Border Grid.Column="1"
                Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1,0,0,0"
                Width="190"
                Visibility="{Binding IsGalleryOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Video Gallery"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HeadingColor}"
                           Margin="0,8,0,10" />

                <!-- Video list -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding VideoGalleryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,8"
                                        Cursor="Hand"
                                        Click="BtnVideoGalleryItem_Click"
                                        ToolTip="{Binding FileName}">
                                    <Button.ContextMenu>
                                        <ContextMenu Background="{StaticResource InputBg}"
                                                     BorderBrush="{StaticResource InputBorder}"
                                                     Foreground="{StaticResource TextPrimary}">
                                            <MenuItem Header="Play"
                                                      Click="BtnVideoGalleryItem_Click" />
                                            <Separator Background="#505050" />
                                            <MenuItem Header="Delete"
                                                      Click="MenuDeleteVideo_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="videoBorder"
                                                    BorderBrush="{StaticResource CardBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Background="{StaticResource InputBg}">
                                                <StackPanel>
                                                    <!-- Thumbnail with play icon overlay -->
                                                    <Grid Margin="4,4,4,0">
                                                        <!-- Thumbnail image (if available) -->
                                                        <Image Source="{Binding Thumbnail}"
                                                               Stretch="Uniform"
                                                               MaxHeight="90"
                                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                                                        <!-- Placeholder when no thumbnail -->
                                                        <Border Background="#252525"
                                                                CornerRadius="3"
                                                                Height="60"
                                                                Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}">
                                                            <Path Data="M 8 0 L 20 10 L 8 20 Z"
                                                                  Fill="{StaticResource TextMuted}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        </Border>
                                                        <!-- Play icon overlay -->
                                                        <Border Background="#60000000"
                                                                CornerRadius="12"
                                                                Width="24" Height="24"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                                                            <Path Data="M 4 2 L 14 8 L 4 14 Z"
                                                                  Fill="White"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                    <!-- File info -->
                                                    <TextBlock Text="{Binding CreatedDate}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               HorizontalAlignment="Center"
                                                               Margin="4,4,4,0" />
                                                    <TextBlock Text="{Binding FileSize}"
                                                               FontSize="9"
                                                               Foreground="{StaticResource TextMuted}"
                                                               HorizontalAlignment="Center"
                                                               Margin="4,0,4,4" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="videoBorder"
                                                            Property="BorderBrush"
                                                            Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

</Window>
