<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ArchSmarterCharrette.VideoTool</RootNamespace>
    <AssemblyName>ArchSmarterCharrette.VideoTool</AssemblyName>
    <ApplicationIcon />
    <Nullable>disable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <!-- Always output to bin/Debug regardless of the Revit-specific configuration name
         (e.g. "Debug R25") so the EXE path is predictable for the add-in launcher -->
    <OutputPath Condition="$(Configuration.StartsWith('Debug'))">bin\Debug</OutputPath>
    <OutputPath Condition="$(Configuration.StartsWith('Release'))">bin\Release</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.GenAI" Version="1.*" />
  </ItemGroup>

</Project>
