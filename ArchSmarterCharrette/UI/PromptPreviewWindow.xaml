<Window x:Class="ReRender.UI.PromptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt Preview"
        Width="520"
        Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Prompt Preview"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#F5C842"
                   Margin="0,0,0,4" />

        <TextBlock Grid.Row="1"
                   Text="This is the exact text that will be sent to the Gemini API alongside your exported view image."
                   FontSize="11"
                   Foreground="#707070"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBox Grid.Row="2"
                 x:Name="TxtPrompt"
                 IsReadOnly="True"
                 Background="#383838"
                 Foreground="#E0E0E0"
                 BorderBrush="#505050"
                 BorderThickness="1"
                 Padding="10,8"
                 FontSize="12"
                 FontFamily="Consolas"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Copy"
                    Width="80"
                    Height="28"
                    Margin="0,0,8,0"
                    Background="#383838"
                    Foreground="#E0E0E0"
                    FontSize="12"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnCopy_Click" />
            <Button Content="Close"
                    Width="80"
                    Height="28"
                    Background="#383838"
                    Foreground="#E0E0E0"
                    FontSize="12"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnClose_Click"
                    IsCancel="True" />
        </StackPanel>
    </Grid>

</Window>
