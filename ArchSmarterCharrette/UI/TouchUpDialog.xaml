<Window x:Class="ReRender.UI.TouchUpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Touch Up Image"
        Width="440"
        Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Thumbnail preview of the image being edited -->
        <Border Grid.Row="0"
                BorderBrush="#505050"
                BorderThickness="1"
                CornerRadius="4"
                Background="#2A2A2A"
                HorizontalAlignment="Center"
                Margin="0,0,0,12">
            <Image x:Name="ImgPreview"
                   MaxHeight="100"
                   MaxWidth="200"
                   Stretch="Uniform"
                   Margin="4" />
        </Border>

        <TextBlock Grid.Row="1"
                   Text="Describe the changes you want:"
                   FontSize="12"
                   Foreground="#A0A0A0"
                   Margin="0,0,0,6" />

        <TextBlock Grid.Row="2"
                   Text="Be specific about what to change. The rest of the image will be preserved."
                   FontSize="10"
                   Foreground="#707070"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />

        <TextBox Grid.Row="3"
                 x:Name="TxtPrompt"
                 Background="#383838"
                 Foreground="#E0E0E0"
                 CaretBrush="#E0E0E0"
                 BorderBrush="#505050"
                 BorderThickness="1"
                 Padding="8,6"
                 FontSize="12"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Send"
                    Width="80"
                    Height="28"
                    Margin="0,0,8,0"
                    Background="#4E9FE5"
                    Foreground="White"
                    FontSize="12"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnSend_Click"
                    IsDefault="True" />
            <Button Content="Cancel"
                    Width="80"
                    Height="28"
                    Background="#383838"
                    Foreground="#E0E0E0"
                    FontSize="12"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnCancel_Click"
                    IsCancel="True" />
        </StackPanel>
    </Grid>

</Window>
