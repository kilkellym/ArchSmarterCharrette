<Window x:Class="ArchSmarterCharrette.UI.RenderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charrette Image"
        Width="600"
        Height="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1E1E1E">

    <Window.Resources>

        <!-- Colors -->
        <SolidColorBrush x:Key="WindowBg" Color="#1E1E1E" />
        <SolidColorBrush x:Key="CardBg" Color="#2D2D2D" />
        <SolidColorBrush x:Key="CardBorder" Color="#3E3E3E" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E0E0E0" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A0A0" />
        <SolidColorBrush x:Key="TextMuted" Color="#707070" />
        <SolidColorBrush x:Key="HeadingColor" Color="#F5C842" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4E9FE5" />
        <SolidColorBrush x:Key="AccentHover" Color="#5DB0F0" />
        <SolidColorBrush x:Key="AccentPressed" Color="#3D8ED4" />
        <SolidColorBrush x:Key="InputBg" Color="#383838" />
        <SolidColorBrush x:Key="InputBorder" Color="#505050" />
        <SolidColorBrush x:Key="InputFocusBorder" Color="#4E9FE5" />
        <SolidColorBrush x:Key="BtnSecondaryBg" Color="#383838" />
        <SolidColorBrush x:Key="BtnSecondaryHover" Color="#454545" />

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource HeadingColor}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Field label -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- Text input -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- System color overrides for ComboBox dropdown -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#383838" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4E9FE5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E0E0E0" />

        <!-- ComboBox toggle button (the closed-state chrome) -->
        <ControlTemplate x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
            <Border x:Name="border"
                    Background="{StaticResource InputBg}"
                    BorderBrush="{StaticResource InputBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <!-- Arrow glyph -->
                    <Path Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{StaticResource TextSecondary}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
        </ControlTemplate>

        <!-- ComboBox -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- The toggle button fills the whole control -->
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggle}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                            <!-- Selected item text -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,28,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <!-- Dropdown popup -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource InputBg}"
                                            BorderBrush="{StaticResource InputBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,1,0,0" />
                                    <ScrollViewer Margin="2,3" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button (Render) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="20,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button (Close) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BtnSecondaryBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource BtnSecondaryHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card container (still used for non-expandable sections if needed) -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Dark-themed Expander -->
        <Style x:Key="DarkExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource HeadingColor}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,0">
                            <StackPanel>
                                <!-- Header row with toggle -->
                                <ToggleButton x:Name="HeaderToggle"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Cursor="Hand"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              HorizontalContentAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0"
                                                                      Content="{TemplateBinding Content}"
                                                                      VerticalAlignment="Center" />
                                                    <Path x:Name="Arrow"
                                                          Grid.Column="1"
                                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                                          Fill="{StaticResource TextSecondary}"
                                                          VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="-90" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <TextBlock Text="{TemplateBinding Header}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource HeadingColor}" />
                                </ToggleButton>
                                <!-- Content area -->
                                <ContentPresenter x:Name="Content"
                                                  Visibility="Collapsed"
                                                  Margin="0,4,0,14" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Content" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

    </Window.Resources>

    <!-- Outer two-column layout: main content + gallery panel -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Main content column -->
        <Grid Grid.Column="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- 0: Title -->
                <RowDefinition Height="Auto" />   <!-- 1: Model + settings + gallery toggle -->
                <RowDefinition Height="*" />      <!-- 2: Scrollable cards -->
                <RowDefinition Height="Auto" />   <!-- 3: Status -->
                <RowDefinition Height="Auto" />   <!-- 4: Buttons -->
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="Charrette Image"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource HeadingColor}"
                       Margin="0,0,0,10" />

            <!-- Model dropdown, settings, and gallery toggle -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Current Model"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" />

                <ComboBox Grid.Column="2"
                          Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModel}" />

                <Button Grid.Column="3"
                        Width="40"
                        Height="24"
                        Padding="0,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="Settings"
                        Margin="8,0,6,0"
                        Click="BtnSettings_Click">
                    <Path Data="M 8 4.8 A 3.2 3.2 0 1 1 8 11.2 A 3.2 3.2 0 1 1 8 4.8 M 7.2 0 L 8.8 0 L 9.2 2.2 L 10.8 2.8 L 12.6 1.6 L 13.8 2.8 L 12.6 4.6 L 13.2 6.2 L 15.4 6.6 L 15.4 8.2 L 13.2 8.6 L 12.6 10.2 L 13.8 12 L 12.6 13.2 L 10.8 12 L 9.2 12.6 L 8.8 14.8 L 7.2 14.8 L 6.8 12.6 L 5.2 12 L 3.4 13.2 L 2.2 12 L 3.4 10.2 L 2.8 8.6 L 0.6 8.2 L 0.6 6.6 L 2.8 6.2 L 3.4 4.6 L 2.2 2.8 L 3.4 1.6 L 5.2 2.8 L 6.8 2.2 Z"
                          Fill="{StaticResource TextSecondary}"
                          Stretch="Uniform"
                          Width="14"
                          Height="14" />
                </Button>

                <Button Grid.Column="4"
                        Width="40"
                        Height="24"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="Toggle gallery"
                        Click="BtnToggleGallery_Click">
                    <Path x:Name="GalleryArrow"
                          Data="M 0 0 L 4 4 L 0 8 Z"
                          Fill="{StaticResource TextSecondary}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Scrollable card area -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Rendering Style -->
                    <Expander Style="{StaticResource DarkExpander}"
                              Header="Rendering Style"
                              IsExpanded="True">
                        <StackPanel>
                            <!-- Prompt Library selector -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Prompt Library" Style="{StaticResource LabelStyle}" />
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding AvailableLibraryFiles}"
                                          SelectedItem="{Binding SelectedLibraryFile}" />
                            </StackPanel>

                            <!-- Theme selector (hidden if no themes in library) -->
                            <StackPanel Visibility="{Binding HasThemes, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,10">
                                <TextBlock Text="Theme" Style="{StaticResource LabelStyle}" />
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding ThemeNames}"
                                          SelectedItem="{Binding SelectedThemeName}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Style -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Style" Style="{StaticResource LabelStyle}" />
                                <ComboBox Grid.Row="1" Grid.Column="0"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding StylePhrases}"
                                          SelectedItem="{Binding SelectedStyle}"
                                          DisplayMemberPath="DisplayName" />

                                <!-- Lighting -->
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="Lighting" Style="{StaticResource LabelStyle}" />
                                <ComboBox Grid.Row="1" Grid.Column="2"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding LightingPhrases}"
                                          SelectedItem="{Binding SelectedLighting}"
                                          DisplayMemberPath="DisplayName" />

                                <!-- Material -->
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="Material" Style="{StaticResource LabelStyle}" />
                                <ComboBox Grid.Row="4" Grid.Column="0"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding MaterialPhrases}"
                                          SelectedItem="{Binding SelectedMaterial}"
                                          DisplayMemberPath="DisplayName" />

                                <!-- Background -->
                                <TextBlock Grid.Row="3" Grid.Column="2"
                                           Text="Background" Style="{StaticResource LabelStyle}" />
                                <ComboBox Grid.Row="4" Grid.Column="2"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding BackgroundPhrases}"
                                          SelectedItem="{Binding SelectedBackground}"
                                          DisplayMemberPath="DisplayName" />

                                <!-- Entourage -->
                                <TextBlock Grid.Row="6" Grid.Column="0"
                                           Text="Entourage" Style="{StaticResource LabelStyle}" />
                                <ComboBox Grid.Row="7" Grid.Column="0"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding EntouragePhrases}"
                                          SelectedItem="{Binding SelectedEntourage}"
                                          DisplayMemberPath="DisplayName" />

                                <!-- Weather -->
                                <TextBlock Grid.Row="6" Grid.Column="2"
                                           Text="Weather" Style="{StaticResource LabelStyle}" />
                                <ComboBox Grid.Row="7" Grid.Column="2"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding WeatherPhrases}"
                                          SelectedItem="{Binding SelectedWeather}"
                                          DisplayMemberPath="DisplayName" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- Custom Directions -->
                    <Expander Style="{StaticResource DarkExpander}"
                              Header="Custom Directions"
                              IsExpanded="True">
                        <StackPanel>
                            <TextBlock Text="Add any specific instructions for the AI renderer."
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="0,0,0,8" />
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding CustomDirections, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="56" />
                        </StackPanel>
                    </Expander>

                    <!-- Output Settings -->
                    <Expander Style="{StaticResource DarkExpander}"
                              Header="Output Settings"
                              IsExpanded="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Image Size -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Image Size" Style="{StaticResource LabelStyle}" />
                            <ComboBox Grid.Row="1" Grid.Column="0"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ImageSizes}"
                                      SelectedItem="{Binding SelectedImageSize}" />

                            <!-- Aspect Ratio -->
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="Aspect Ratio" Style="{StaticResource LabelStyle}" />
                            <ComboBox Grid.Row="1" Grid.Column="2"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding AspectRatios}"
                                      SelectedItem="{Binding SelectedAspectRatio}" />
                        </Grid>
                    </Expander>

                    <!-- Presets -->
                    <Expander Style="{StaticResource DarkExpander}"
                              Header="Presets"
                              IsExpanded="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding PresetNames}"
                                      SelectedItem="{Binding SelectedPresetName}" />

                            <Button Grid.Column="2"
                                    Content="Save"
                                    Width="70"
                                    Height="28"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnSavePreset_Click" />

                            <Button Grid.Column="4"
                                    Content="Delete"
                                    Width="70"
                                    Height="28"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnDeletePreset_Click" />
                        </Grid>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <!-- Status area -->
            <StackPanel Grid.Row="3">
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,0,0,8"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource CardBg}"
                             BorderThickness="0"
                             Visibility="{Binding IsRendering, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           Foreground="{Binding StatusColor}"
                           FontSize="12"
                           Margin="4,0,0,0" />
            </StackPanel>

            <!-- Button row -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- View Prompt (left-aligned) -->
                <Button Grid.Column="0"
                        Width="34"
                        Height="30"
                        ToolTip="View prompt text"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnViewPrompt_Click">
                    <Path Data="M 8 3 C 3 3 0.5 8 0.5 8 C 0.5 8 3 13 8 13 C 13 13 15.5 8 15.5 8 C 15.5 8 13 3 8 3 Z M 8 11 C 6.34 11 5 9.66 5 8 C 5 6.34 6.34 5 8 5 C 9.66 5 11 6.34 11 8 C 11 9.66 9.66 11 8 11 Z M 8 6.5 C 7.17 6.5 6.5 7.17 6.5 8 C 6.5 8.83 7.17 9.5 8 9.5 C 8.83 9.5 9.5 8.83 9.5 8 C 9.5 7.17 8.83 6.5 8 6.5 Z"
                          Fill="{StaticResource TextSecondary}"
                          Stretch="Uniform"
                          Width="16"
                          Height="16" />
                </Button>

                <!-- Video + Render + Close (right-aligned) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Content="Video"
                            Width="80"
                            Height="30"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding HasRenderedImage}"
                            ToolTip="Generate a video from the last rendered image"
                            Click="BtnVideo_Click" />
                    <Button Content="Render"
                            Width="110"
                            Height="30"
                            Margin="0,0,10,0"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanRender}"
                            Click="BtnRender_Click" />
                    <Button Content="Close"
                            Width="90"
                            Height="30"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnClose_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Gallery side panel -->
        <Border Grid.Column="1"
                Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1,0,0,0"
                Width="180"
                Visibility="{Binding IsGalleryOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Render Gallery"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HeadingColor}"
                           Margin="0,8,0,10" />

                <!-- Thumbnail list -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding GalleryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,8"
                                        Cursor="Hand"
                                        Tag="{Binding FilePath}"
                                        Click="BtnGalleryImage_Click"
                                        ToolTip="{Binding FileName}">
                                    <Button.ContextMenu>
                                        <ContextMenu Background="{StaticResource InputBg}"
                                                     BorderBrush="{StaticResource InputBorder}"
                                                     Foreground="{StaticResource TextPrimary}">
                                            <MenuItem Header="Use these settings"
                                                      Click="MenuUseSettings_Click" />
                                            <MenuItem Header="Open in viewer"
                                                      Click="MenuOpenImage_Click" />
                                            <Separator Background="#505050" />
                                            <MenuItem Header="Touch up"
                                                      Click="MenuTouchUp_Click" />
                                            <Separator Background="#505050" />
                                            <MenuItem Header="Delete"
                                                      Click="MenuDeleteImage_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="thumbBorder"
                                                    BorderBrush="{StaticResource CardBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Background="{StaticResource InputBg}">
                                                <StackPanel>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="Uniform"
                                                           MaxHeight="100"
                                                           Margin="4" />
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontSize="9"
                                                               Foreground="{StaticResource TextMuted}"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Center"
                                                               Margin="4,0,4,4" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumbBorder"
                                                            Property="BorderBrush"
                                                            Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Gallery action buttons -->
                <StackPanel Grid.Row="2" Margin="0,8,0,10">
                    <Button Content="Open Folder"
                            Height="32"
                            FontSize="11"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnOpenFolder_Click" />
                    <Button Content="Clear Gallery"
                            Height="32"
                            FontSize="11"
                            Margin="0,6,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnClearGallery_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
